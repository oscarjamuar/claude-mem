{
  "description": "Claude-mem memory system hooks",
  "hooks": {
    "Setup": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"var r=process.env.CLAUDE_PLUGIN_ROOT||require('path').join(require('os').homedir(),'.claude','plugins','marketplaces','thedotmack','plugin');process.argv[2]='setup';require(r+'/scripts/hook-runner.js')\"",
            "timeout": 300
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"var r=process.env.CLAUDE_PLUGIN_ROOT||require('path').join(require('os').homedir(),'.claude','plugins','marketplaces','thedotmack','plugin');process.argv[2]='setup';require(r+'/scripts/hook-runner.js')\"",
            "timeout": 300
          },
          {
            "type": "command",
            "command": "node -e \"var r=process.env.CLAUDE_PLUGIN_ROOT||require('path').join(require('os').homedir(),'.claude','plugins','marketplaces','thedotmack','plugin');process.argv[2]='start-worker';require(r+'/scripts/hook-runner.js')\"",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "node -e \"var r=process.env.CLAUDE_PLUGIN_ROOT||require('path').join(require('os').homedir(),'.claude','plugins','marketplaces','thedotmack','plugin');process.argv[2]='context';require(r+'/scripts/hook-runner.js')\"",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"var r=process.env.CLAUDE_PLUGIN_ROOT||require('path').join(require('os').homedir(),'.claude','plugins','marketplaces','thedotmack','plugin');process.argv[2]='session-init';require(r+'/scripts/hook-runner.js')\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"var r=process.env.CLAUDE_PLUGIN_ROOT||require('path').join(require('os').homedir(),'.claude','plugins','marketplaces','thedotmack','plugin');process.argv[2]='observation';require(r+'/scripts/hook-runner.js')\"",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"var r=process.env.CLAUDE_PLUGIN_ROOT||require('path').join(require('os').homedir(),'.claude','plugins','marketplaces','thedotmack','plugin');process.argv[2]='file-context';require(r+'/scripts/hook-runner.js')\"",
            "timeout": 2000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"var r=process.env.CLAUDE_PLUGIN_ROOT||require('path').join(require('os').homedir(),'.claude','plugins','marketplaces','thedotmack','plugin');process.argv[2]='summarize';require(r+'/scripts/hook-runner.js')\"",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"var r=process.env.CLAUDE_PLUGIN_ROOT||require('path').join(require('os').homedir(),'.claude','plugins','marketplaces','thedotmack','plugin');process.argv[2]='session-complete';require(r+'/scripts/hook-runner.js')\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
